{
  "name": "sentry-bridge",
  "version": "1.2.0",
  "description": "Docker-based agent connecting Prusa Core One (PrusaLink) to Obico",
  "main": "dist/index.js",
  "scripts": {
    "install:all": "npm install && cd frontend && npm install",
    "dev:backend": "CONFIG_PATH=./config/config.json tsx watch src/index.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend:proxy\"",
    "dev:frontend:proxy": "cd frontend && npm run dev:proxy",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "start:backend": "node dist/index.js",
    "start:all": "npm run build:all && npm run start:backend",
    "test:backend": "jest --forceExit",
    "test:all": "npm run test:backend",
    "typecheck": "tsc --noEmit",
    "build:docker": "docker build -t sentry-bridge .",
    "build:docker:multiplatform": "docker buildx build --platform linux/amd64,linux/arm64 -t sentry-bridge .",
    "docker:dev": "docker compose up --build -d",
    "docker:run": "docker compose up --pull never -d",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down --rmi local; true",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "bson": "^7.3.4",
    "digest-fetch": "^3.1.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.3.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.3",
    "husky": "^9.0.11",
    "jest": "^30.5.0",
    "jest-html-reporter": "^4.4.0",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.10.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
